# Application
APP_NAME=V-POS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Optional hostname-only override; when blank, the hostname is derived from APP_URL.
CENTRAL_PORTAL_HOST=
# Optional tenant-domain suffix; when blank, CENTRAL_PORTAL_HOST is used.
TENANT_HOST=

# Development and diagnostics
DEBUGBAR_ENABLED=true
TELESCOPE_ENABLED=true
TELESCOPE_DB_CONNECTION=central
TELESCOPE_AUTH_EMAILS=admin@example.local

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Cache, queues, sessions, and filesystems
BROADCAST_DRIVER=log
CACHE_DRIVER=file
POS_DISPLAY_CACHE_STORE=pos_display
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Maps
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Trust GeoIP headers only when a controlled edge proxy overwrites them.
GEOIP_TRUST_PROVIDER_HEADERS=false

# Realtime and Pusher
PUSHER_APP_ID=pos_app
PUSHER_APP_KEY=pos_key
PUSHER_APP_SECRET=pos_secret
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
NEXT_PUBLIC_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
NEXT_PUBLIC_PUSHER_PORT="${PUSHER_PORT}"
NEXT_PUBLIC_PUSHER_SCHEME="${PUSHER_SCHEME}"
NEXT_PUBLIC_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Next.js
NEXT_PUBLIC_LAN_IP=
NEXT_MODE=dev

# Sentry
SENTRY_LARAVEL_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Telegram
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT=10

# Translation
LNG_ALLOWED=en,kh,km
TRANSLATION_SERVICE_URL=http://fastapi-app:8000/api/translate
VISION_EMBEDDING_SERVICE_URL=http://fastapi-app:8000/api/image-embeddings
VISION_EMBEDDING_TIMEOUT=45

# Monitoring (optional; integrations fail closed and are disabled by default)
MONITORING_ENABLED=false
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_CONNECT_TIMEOUT=1
PROMETHEUS_TIMEOUT=2
NODE_EXPORTER_ENABLED=false
CADVISOR_ENABLED=false
CADDY_METRICS_ENABLED=false
LARAVEL_METRICS_ENABLED=false
PULSE_ENABLED=false
PULSE_DB_CONNECTION=central
PULSE_STORAGE_KEEP="7 days"
PULSE_CACHE_INTERACTIONS_ENABLED=false
PULSE_USER_REQUESTS_SAMPLE_RATE=0.1
PULSE_USER_JOBS_SAMPLE_RATE=0.1
MONITORING_SLOW_REQUEST_MS=1000
MONITORING_SLOW_QUERY_MS=500
MONITORING_RECENT_EVENT_LIMIT=50
MONITORING_MAX_SERIES=500
MONITORING_REFRESH_SECONDS=15
